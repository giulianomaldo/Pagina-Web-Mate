# ─── Server ─────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database PostgreSQL (Supabase) ──────
DB_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres

# ─── JWT ────────────────────────────────
JWT_SECRET=cambia_este_secreto_muy_largo_y_seguro
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=otro_secreto_distinto_para_refresh
JWT_REFRESH_EXPIRES_IN=7d

# ─── Supabase (Storage) ───────────────────
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key-o-service-role-key
SUPABASE_BUCKET=encontrarte

# ─── CORS ───────────────────────────────
CLIENT_URL=http://localhost:5173
